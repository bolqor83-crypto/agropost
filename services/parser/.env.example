# Парсер цен (services/parser). Скопируйте в .env и заполните.

# Та же база, что у основного API (Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Этап 5.1: внутренний секрет сервер-сервер — Node API вызывает
# POST /run только с этим заголовком X-Parser-Secret. Без него
# /run отвечает отказом (fail-closed). Совпадает с PARSER_SECRET
# в env agropost-api.
PARSER_SECRET=""

# Агросервер: sitemap-подход, 1 запрос / 2 сек, robots.txt обязателен
# (недоступен → обход запрещён, fail-closed).
AGROSERVER_QUERIES="люцерна,эспарцет,суданка,грецкий орех"

# Telegram (MTProto, Telethon) — отдельный аккаунт.
# ЭТАП 5.1: сбор публичных каналов ВЫКЛЮЧЕН по умолчанию
# (TG_COLLECT_ENABLED=0). Включайте только для источников, на
# обработку которых есть подтверждённое право (свои каналы,
# официальные API). Креды и сессия — только в .env.
TG_COLLECT_ENABLED="0"
TG_API_ID=""
TG_API_HASH=""
TG_SESSION=""
TG_CHANNELS="selhoz032,RUSSIAN_WHOLESALER"

# Cron внутри сервиса: раз в N часов (0 = выключить).
SCHEDULER_INTERVAL_HOURS="12"
