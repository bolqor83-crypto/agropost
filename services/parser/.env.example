# АгроПост — сервис парсера цен (этап 2.5).
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env в git.

# База — та же, что у основного API (Neon).
DATABASE_URL=postgresql://agropost:CHANGE_ME@ep-quiet-cherry-betrrzgm.c-9.us-east-2.aws.neon.tech/agropost?sslmode=require

# Порт сервиса.
PORT=8000

# Запросы парсера (ТЗ этапа 2.5; «суданская трава» ищется как «суданка»).
AGROSERVER_QUERIES=люцерна,эспарцет,суданка,грецкий орех

# Агросервер: сколько ПЕРВЫХ чанков sitemap читать (объявления в старых;
# для первого полного наполнения истории поставьте 30) и сколько
# объявлений брать на запрос (вежливость: не выкачиваем всё).
AGROSERVER_SITEMAP_CHUNKS=3
AGROSERVER_MAX_ADS_PER_QUERY=5

# Лимит: не более 1 запроса в 2 секунды (ТЗ). Не снижать без причины.
AGROSERVER_REQUEST_INTERVAL=2.0

# Telegram — ОТДЕЛЬНЫЙ аккаунт парсера (не основной!).
# 1) Получите api_id/api_hash на my.telegram.org → заполните.
# 2) python -m app.login → телефон + код → строку в TG_SESSION.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Публичные каналы для сбора (без @, через запятую; не более 500).
TG_CHANNELS=selhoz032,RUSSIAN_WHOLESALER

# Сколько последних сообщений канала просматриваем.
TG_MESSAGES_LIMIT=200

# Пауза между каналами (лимит 1–2 запроса/сек).
TG_REQUEST_INTERVAL=1.5

# Cron внутри сервиса: раз в 12 часов (0 = только ручной POST /run).
SCHEDULER_INTERVAL_HOURS=12
