# АгроПост — переменные окружения сервера (apps/server)
# Скопируйте в .env и заполните. .env никогда не коммитится.

# PostgreSQL (Neon). Этап 1+.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Порт Render (подставляется автоматически), локально — 3001.
PORT=3001

# AI-слой (этап 3.0). Ключи только на бэкенде, в клиент не уходят.
# GLM через Z.AI — основной провайдер; OpenRouter — резервный канал.
AI_PROVIDER=glm
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GLM_MODEL_FLASH="glm-5.3-flash"
GLM_MODEL_PRO="glm-5.3"
OPENROUTER_API_KEY=""
# Старое имя переменной из render.yaml — тоже поддерживается.
OPENROUTER_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Патч 4.1: каскад моделей OpenRouter (через запятую) — пробуем по списку,
# пока не получим ответ. По умолчанию — бесплатные модели:
# deepseek/deepseek-v4-flash-0731:free, qwen/qwen3.8-27b:free,
# google/gemma-4-26b-a4b-it:free, nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODELS=""
AI_TIMEOUT_MS=30000

# Cloudflare R2 — файлы (этап 6: PDF документов, фото рекламаций, медиа позиций).
# Как настроить — README, раздел «Как настроить R2».
# R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL: публичный домен бакета, например https://pub-xxxx.r2.dev
R2_ENDPOINT=""
R2_BUCKET="agropost-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
# ЭТАП 6: режим файлового хранилища. Пусто/не задано — авто (R2, когда все
# 5 значений выше заполнены; иначе base64-в-БД). "true" — включить R2,
# "false" — выключить (файлы в базе). При base64 приложение работает,
# в логе честное предупреждение, медиа хранятся в БД.
R2_CONFIGURED=""

# Telegram-бот для своих каналов (этап 3, grammY).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_USER_ID=""
# TELEGRAM_WEBHOOK_URL: свой полный URL вебхука (по умолчанию выводится из RENDER_EXTERNAL_URL).
TELEGRAM_WEBHOOK_URL=""
# TELEGRAM_WEBHOOK_SECRET: свой секрет заголовка X-Telegram-Bot-Api-Secret-Token.
# По умолчанию выводится детерминированно из токена бота (устойчиво к рестартам).
TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_WEB_URL: публичный адрес веб-приложения, для ссылок в уведомлениях.
TELEGRAM_WEB_URL=""

# Этап 5.1 — авторизация владельца (обязательна для приватных маршрутов).
# Пароль в открытом виде НИГДЕ не хранится: только Argon2id-хеш.
# Получить хеш своего пароля: cd apps/server && bun run hash-password
OWNER_LOGIN="agropost"
OWNER_PASSWORD_HASH=""
# Срок сессии (часы, по умолчанию 14 дней) и лимит попыток входа.
SESSION_TTL_HOURS="336"
LOGIN_MAX_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"
# Доверенные origin для CORS (через запятую; прод — домен веб-приложения).
TRUSTED_ORIGINS="https://agropost-web.onrender.com,http://localhost:5173"

# Этап 5.1 — парсер цен: адрес Python-сервиса и внутренний секрет
# сервер-сервер (Node → Python /run). Одинаковый секрет в env обоих
# сервисов. Без PARSER_URL в production /api/parser/* честно отвечает
# «Парсер не настроен». MTProto-сбор ТГ по умолчанию выключен —
# см. services/parser/.env.example (TG_COLLECT_ENABLED).
PARSER_URL=""
PARSER_SECRET=""

# ЭТАП 9 — фиды площадок (Зерно Он-Лайн, Своё Фермерство, Авито).
# Площадки забирают объявления по XML-ссылке сами; ссылки — в
# «Ещё» → «Настройки» (или README, раздел «Как подключить YML-фид»).
# FEED_TOKEN: openssl rand -hex 16 (32 символа). Не задан — фиды
# отключены (/api/feeds/* отвечает 403), приложение работает.
FEED_TOKEN=""
# Публичная витрина для ссылок офферов (по умолчанию — прод-домен web).
FEED_SHOP_URL="https://agropost-web.onrender.com"
# Публичный адрес API: по нему Авито забирает Авито-фид (на Render
# подставляется RENDER_EXTERNAL_URL автоматически).
# PUBLIC_API_URL="https://agropost-api.onrender.com"
# Кэш фида, мс (по умолчанию 1 час — площадки не дёргают каждую секунду).
# FEED_CACHE_TTL_MS="3600000"

# ЭТАП 9 — Авито API (официальный, бесплатный: Авито → «Для бизнеса» →
# «Интеграции» → API; нужен профиль ИП/юрлица). Ключи можно ввести и в
# UI («Ещё» → «Настройки» → «Авито API») — env имеет приоритет.
# Без ключей приложение работает как раньше (полуавто), dry-run и
# публикация честно отвечают «Авито API не настроен».
AVITO_CLIENT_ID=""
AVITO_CLIENT_SECRET=""
# ID профиля Авито (число из профиля).
AVITO_USER_ID=""
# Телефон продавца для объявлений (ContactPhone в XML; не задан —
# Авито покажет телефон профиля).
AVITO_CONTACT_PHONE=""
# База API (подменяется только в тестах).
# AVITO_API_BASE="https://api.avito.ru"
# Категории Авито по типу культуры (можно подстроить под каталог Авито
# после первого dry-run: валидатор покажет расхождения).
# AVITO_CATEGORY_SEED="Товары для дома и дачи"
# AVITO_CATEGORY_NUT="Продукты питания"
