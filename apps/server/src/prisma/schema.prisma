// АгроПост — схема Prisma.
// Этап 0: каркас. Этап 1: Supplier, CultureTemplate, SupplierPosition
// (attributes JsonB по шаблону культуры), Media, Certificate, User.
// Этап 2: Channel, Account, Listing. Этап 4: Deal, Shipment, Claim, Document.
// Этап 2.5 (парсер): CompetitorPrice, PriceAlert.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- Этап 1: поставщики, культуры, позиции, медиа ---------- */

enum SupplierLocation {
  PAVLOVSKAYA
  LENINGRADSKAYA
  TIHORETSK
  OTHER
}

enum ShippingMode {
  SELF_LOADS
  FROM_WAREHOUSE
  BOTH
}

enum CultureType {
  SEED
  NUT
}

enum PositionStatus {
  IN_STOCK
  ON_ORDER
  OUT_OF_STOCK
}

enum MediaType {
  PHOTO
  VIDEO
}

enum TaxMode {
  IP
  SELF_EMPLOYED
}

/* ---------- Этап 2: каналы, аккаунты, размещения ---------- */

enum ChannelType {
  TELEGRAM_CHAT
  TELEGRAM_CHANNEL
  AVITO
  AGROSERVER
  MAX
  YOULA
  OTHER
}

enum AccountPlatform {
  TELEGRAM
  AVITO
  MAX
  YOULA
  OTHER
}

enum AccountStatus {
  ACTIVE
  LIMITED
  PAUSED
  BLOCKED
}

enum ListingStatus {
  DRAFT
  COPIED
  PUBLISHED
}

/* Этап 2.5: способы подачи и профиль канала (исследование рынка). */

enum SubmissionMethod {
  BOT
  ADMIN_CONTACT
  SITE_FORM
  CABINET
  NONE
}

enum ConfirmationStatus {
  CONFIRMED
  REQUIRES_CHECK
}

enum AudienceType {
  B2B
  B2C
  REGIONAL
  GENERAL
}

/* ЭТАП 9: уровень автоматизации публикации в канал.
   AUTO — фид/API обновляют объявления сами (YML-площадки, Авито API,
   свой бот-админ); SEMI — приложение готовит текст, пользователь вставляет
   (чужие чаты, Агросервер); MANUAL — только точка входа (НССиС). */
enum AutomationLevel {
  AUTO
  SEMI
  MANUAL
}

/* Этап 2.5 (парсер): источник собранной цены. */

enum PriceSource {
  AGROSERVER
  TELEGRAM
}

model Supplier {
  id           String             @id @default(cuid())
  name         String
  phone        String
  location     SupplierLocation
  shippingMode ShippingMode
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  positions    SupplierPosition[]

  @@index([location])
}

model CultureTemplate {
  id               String             @id @default(cuid())
  name             String             @unique
  type             CultureType
  /// Массив {key, label, type, displayType?, unit, required} — схема
  /// атрибутов позиций. displayType (FIXED/RANGE/MIN/TEXT, патч 4.1) —
  /// формат значения: контракт для AI «только переданные числа».
  attributesSchema Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  positions        SupplierPosition[]

  @@index([type])
}

model SupplierPosition {
  id             String           @id @default(cuid())
  supplier       Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId     String
  culture        CultureTemplate  @relation(fields: [cultureId], references: [id], onDelete: Restrict)
  cultureId      String
  /// Плоский JSONB {key: value} по схеме attributesSchema культуры.
  attributes     Json
  /// Остаток, кг. Обновляется вручную.
  volumeKg       Int
  bagWeightKg    Int
  /// Закуп поставщика, ₽/кг.
  supplierPrice  Decimal          @db.Decimal(10, 2)
  markupPercent  Decimal          @db.Decimal(5, 2)
  /// Вычисляется на сервере: supplierPrice × (1 + markupPercent / 100).
  salePrice      Decimal          @db.Decimal(10, 2)
  minLotKg       Int
  hasCertificate Boolean          @default(false)
  status         PositionStatus   @default(IN_STOCK)
  /* Этап 5.1: фактическое начало наличия — не createdAt. Для старых
     позиций null = «неизвестно» (не выдумываем дату). Заполняется при
     создании со статусом IN_STOCK и при возврате в IN_STOCK. */
  stockSince     DateTime?
  media          Media[]
  certificates   Certificate[]
  listings       Listing[]
  leads          Lead[]
  /* Этап 4: сделки по позиции. */
  deals          Deal[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([supplierId])
  @@index([cultureId])
  @@index([status])
  @@index([updatedAt])
}

model Media {
  id         String           @id @default(cuid())
  position   SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String
  type       MediaType
  /// Публичный URL в R2 (в демо-сиде — data-URL заглушки).
  url        String
  watermark  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([positionId])
}

model Certificate {
  id         String           @id @default(cuid())
  position   SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String
  name       String
  fileUrl    String
  issuedAt   DateTime?
  createdAt  DateTime         @default(now())

  @@index([positionId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  taxMode   TaxMode
  /// Доля налога, например 0.06 (УСН доходы) или 0.07 (НПД).
  taxRate   Decimal  @db.Decimal(5, 4)
  /* Этап 4: реквизиты для документов (счёт, договор, ТН, УПД). */
  /// ОГРНИП (для ИП) или ОГРН (для юрлица).
  ogrnip    String?
  /// Юридический/почтовый адрес продавца.
  address   String?
  /// Банк плательщика (название).
  bank      String?
  bik       String?
  /// Расчётный счёт (р/с).
  account   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* Этап 2. Теги каналов — String[] со словарём в коде (shared/channels.ts,
   zod-валидация): новый тег без миграции. Сессии аккаунтов — этап 3. */

model Account {
  id         String          @id @default(cuid())
  platform   AccountPlatform
  phone      String?
  status     AccountStatus   @default(ACTIVE)
  /// Лимит размещений в день (учёт; автоматический постинг — этап 3).
  dailyLimit Int             @default(20)
  /// Использовано за день usedDate (сбрасывается при смене дня).
  usedToday  Int             @default(0)
  usedDate   DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  channels   Channel[]

  @@index([platform])
  @@index([status])
}

model Channel {
  id               String      @id @default(cuid())
  name             String
  type             ChannelType
  /// Deep link: t.me/username, t.me/c/XXX, URL подачи/чата.
  url              String
  region           String
  /// Город для гео-ротации (этап 2.1); null — канал на весь регион.
  city             String?
  tags             String[]
  subscribersCount Int?
  averageReach     Int?
  lastActivityAt   DateTime?
  /// Аккаунт, которым размещаем (SetNull при удалении аккаунта).
  accountId        String?
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes            String?
  /* Этап 2.5: подача и профиль (docs/CHANNEL_RESEARCH.md). */
  /// Как подавать объявление в канал.
  submissionMethod    SubmissionMethod  @default(NONE)
  /// Бот-приёмщик, например @Taganrog_Predlozhka_bot.
  submissionBotUsername String?
  /// Контакт администратора, например @admn_013.
  adminContact       String?
  /// Лимит подач, например «2 раза в день».
  frequencyLimit     String?
  /// Честный статус канала: проверен / требует проверки.
  confirmationStatus ConfirmationStatus @default(CONFIRMED)
  /// Зеркало канала на другой площадке (TG↔MAX) — id канала-зеркала.
  mirrorOf           String?
  /// Профиль аудитории: агро-чат (B2B) или барахолка (REGIONAL).
  audienceType       AudienceType?
  /* ЭТАП 9: бейдж автоматизации в мастере «Разместить». */
  automationLevel    AutomationLevel @default(SEMI)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  listings         Listing[]
  /// Связка «наш бот — админ канала» (этап 3.2, автопостинг).
  botConfig        BotConfig?
  /// Этот канал — зеркало mirrorOf-канала (обратная сторона self-FK).
  mirroredBy       Channel[]   @relation("ChannelMirror")
  /// Канал, зеркалом которого является этот (self-FK, TG↔MAX).
  mirror           Channel?    @relation("ChannelMirror", fields: [mirrorOf], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([region])
  /* ЭТАП 5.2: индексы этапа 2.5 объявлены в схеме — раньше их создавал
     baseline (и прод через db push), а схема молчала: migrate dev показывал
     дрейф. Теперь история миграций и schema.prisma согласованы. */
  @@index([submissionMethod])
  @@index([audienceType])
  @@index([mirrorOf])
  @@index([automationLevel])
}

/* ЭТАП 9: ключ-значение настроек приложения (ключи Авито API, если их
   задали через UI, а не env; env имеет приоритет над БД). */
model AppSetting {
  id        String   @id @default(cuid())
  /// Ключ секции: "avito" — ключи клиента Авито API.
  key       String   @unique
  /// Значение секции (JSONB): {clientId, clientSecret, userId, phone}.
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id          String           @id @default(cuid())
  position    SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId  String
  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String
  /// Черновик текста (white-label: поставщик не упоминается).
  text        String
  status      ListingStatus    @default(DRAFT)
  publishedAt DateTime?
  /// Сколько раз отмечали «размещено» (этап 2.1: растёт при повторной отметке).
  publishedCount Int            @default(0)
  /// Ссылка на опубликованное сообщение (этап 3.2: постинг через своего бота).
  url         String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([positionId])
  @@index([channelId])
  @@index([status])
}

/* ---------- Этап 3.0: журнал вызовов AI ---------- */

enum AiCallStatus {
  OK
  RETRY
  FALLBACK
  ERROR
}

/// Один вызов AI: контракт, хэш входа, результат и расход токенов.
/// Нужен для отладки промптов и оценки стоимости golden set.
model AiCall {
  id           String       @id @default(cuid())
  useCase      String
  /// SHA-256(JSON.stringify({useCase, input})) — ключ кэша.
  inputHash    String
  /// Итоговые данные (AI или fallback) — для аудита.
  outputJson   Json?
  latencyMs    Int          @default(0)
  status       AiCallStatus
  errorMessage String?
  tokensIn     Int?
  tokensOut    Int?
  /// Провайдер и модель — чтобы видеть, кто реально отвечал.
  provider     String?
  model        String?
  createdAt    DateTime     @default(now())

  @@index([useCase, createdAt])
  @@index([inputHash])
}

/* ---------- Этап 3.2: лиды, инбокс, Telegram-бот ---------- */

enum LeadSource {
  TELEGRAM_BOT
  TELEGRAM_CHAT
  /* ЭТАП 10: входящие сообщения покупателей из MAX-бота. */
  MAX
  AVITO
  MANUAL
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Покупатель, который написал (этап 3.2). Модель сразу рассчитана
/// на несколько источников; Telegram-источник отличает externalId.
model Lead {
  id               String            @id @default(cuid())
  source           LeadSource        @default(TELEGRAM_BOT)
  /// Telegram user id покупателя (для TELEGRAM_BOT / TELEGRAM_CHAT).
  externalId       String?
  /// @username покупателя, если есть.
  externalUsername String?
  /// first_name + last_name из профиля Telegram.
  name             String?
  phone            String?
  region           String?
  /// Извлечённый интерес: «люцерна 2 класс».
  interest         String?
  status           LeadStatus        @default(NEW)
  /// Позиция, о которой спросил покупатель (deep link ?start=pos_...).
  positionId       String?
  position         SupplierPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  notes            String?
  messages         Message[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /* Этап 4: сделки, созданные из лида. */
  deals            Deal[]
  /* Этап 5.1: настоящая аттрибуция источника (deep link объявления).
     First Touch — первый достоверно известный источник; Last Touch —
     последний. Простые колонки без FK: канал/объявление могут быть
     удалены — тогда аналитика честно покажет «канал удалён».
     Старые ссылки pos_... эти поля не заполняют (источник неизвестен). */
  firstListingId   String?
  firstChannelId   String?
  lastListingId    String?
  lastChannelId    String?
  /// История касаний объявлений (LeadTouch).
  touches          LeadTouch[]

  @@index([source])
  @@index([status])
  @@index([externalId])
  @@index([positionId])
  @@index([lastChannelId])
  @@index([firstChannelId])
  @@unique([source, externalId])
}

/// Касание лида объявлением (этап 5.1): переход по deep link
/// t.me/{bot}?start=lst_{listingId}. История обращений одного
/// покупателя из разных объявлений/каналов.
model LeadTouch {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  /// Объявление, по которому пришли (id Listing; без FK — листинг
  /// может быть удалён, история касаний остаётся).
  listingId  String
  /// Канал объявления на момент касания (без FK, аналогично).
  channelId  String
  createdAt  DateTime @default(now())

  @@unique([leadId, listingId])
  @@index([leadId])
  @@index([channelId])
}

model Message {
  id                String           @id @default(cuid())
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId            String
  direction         MessageDirection
  text              String
  sentAt            DateTime         @default(now())
  /// Ответ сгенерирован AI (/api/ai/reply) и отправлен как есть/с правками.
  aiGenerated       Boolean          @default(false)
  /// id AiCall, сгенерировавшего черновик (строка-ссылка без FK — AI-слой не трогаем).
  aiCallId          String?
  /// Telegram message_id: дедупликация ретраев webhook + привязка reply.
  telegramMessageId String?
  createdAt         DateTime         @default(now())

  @@index([leadId, sentAt])
  @@unique([leadId, telegramMessageId])
}

/// Каналы, где наш бот — админ (проверено через getChatMember при публикации).
model BotConfig {
  id             String   @id @default(cuid())
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId      String
  /// Chat id канала (-100…) — куда бот постит напрямую.
  telegramChatId String
  isAdmin        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([channelId])
}

/* ---------- Этап 4: сделки, доставка, документы, рекламации ---------- */

enum DealStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CLOSED
  CANCELLED
}

enum DealTaxMode {
  IP_6
  SELF_EMPLOYED_4
  SELF_EMPLOYED_6
}

enum DeliveryMethod {
  PICKUP
  TK
  FELLOW_TRAVELER
}

enum DocumentType {
  INVOICE
  CONTRACT
  TRANSPORT_NOTE
  UPD
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum ClaimStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
  FORWARDED_TO_SUPPLIER
}

/// Справочник транспортных компаний (этап 4). isLocal — в радиусе 50 км
/// от Павловской: им отдаётся приоритет в калькуляторе доставки.
model Carrier {
  id             String     @id @default(cuid())
  name           String     @unique
  /// Город базирования ТК (для приоритета и маршрута).
  city           String
  /// Забирает груз со склада поставщика.
  pickupAvailable Boolean    @default(false)
  /// В радиусе 50 км от Павловской.
  isLocal        Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  shipments      Shipment[]

  @@index([isLocal])
  @@index([city])
}

/// Сделка (этап 4). Отправка — только после ПОЛНОЙ оплаты; доставку
/// всегда оплачивает покупатель (в маржу не входит — хранится отдельно).
model Deal {
  id            String            @id @default(cuid())
  /// Номер «СД-0001» — сквозной инкремент.
  number        String            @unique
  /// Лид, из которого создана сделка (опционально).
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  positionId    String?
  position      SupplierPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  buyerName     String
  buyerPhone    String
  buyerRegion   String
  buyerInn      String?
  /// Объём, кг.
  volumeKg      Decimal           @db.Decimal(12, 3)
  /// Цена продажи, ₽/кг.
  salePrice     Decimal           @db.Decimal(10, 2)
  /// Закуп поставщика (фиксируется из позиции на момент сделки), ₽/кг.
  supplierPrice Decimal           @db.Decimal(10, 2)
  /// Налоговый режим сделки (по умолчанию наследуется из профиля).
  taxMode       DealTaxMode       @default(IP_6)
  /// Считается на сервере: выручка × ставка.
  taxAmount     Decimal           @db.Decimal(12, 2)
  /// (продажа − закуп) × объём − налог.
  margin        Decimal           @db.Decimal(12, 2)
  deliveryMethod DeliveryMethod  @default(PICKUP)
  /// Стоимость доставки (платит покупатель, в маржу не входит).
  deliveryCost  Decimal?
  status        DealStatus        @default(DRAFT)
  paidAt        DateTime?
  shippedAt    DateTime?
  deliveredAt   DateTime?
  /* Этап 5.1: дата закрытия — аналитика выручки по периодам считается
     по ней, а не по createdAt. Старым закрытым сделкам дату не выдумываем:
     остаётся null (учитываются только в периоде «всё время»). */
  closedAt      DateTime?
  /* Этап 5.1: снимок условий сделки на момент создания — история не
     теряется при изменении/удалении позиции поставщика. Данные
     поставщика — только внутри приложения, в документы покупателю не
     попадают (white-label). */
  /// positionName на момент создания.
  itemName          String?
  /// Культура из снимка.
  itemCulture       String?
  /// Атрибуты позиции на момент создания.
  itemAttributes    Json?
  /// Название поставщика на момент создания (только для владельца).
  supplierName      String?
  /// Место отгрузки поставщика (метка) на момент создания.
  supplierLocation  String?
  /// Способ передачи груза поставщика на момент создания.
  shippingMode      String?
  /// Доп. затраты на доставку до терминала ТК (₽) — входят в
  /// себестоимость: вычитаются из маржи. Привёз сам — 0/не указано.
  deliveryToTerminalCost Decimal? @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  shipments     Shipment[]
  documents     Document[]
  claims        Claim[]

  @@index([status])
  @@index([createdAt])
  @@index([positionId])
  @@index([closedAt])
}

/// Отгрузка по сделке (создаётся действием «Отгрузить»).
model Shipment {
  id             String         @id @default(cuid())
  deal           Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId         String
  carrierId      String?
  carrier        Carrier?       @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  method         DeliveryMethod
  /// Название ТК, если не из справочника.
  carrierName    String?
  fromCity       String
  toCity         String
  cost           Decimal        @db.Decimal(12, 2)
  days           Int?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([dealId])
}

/// PDF-документ по сделке. fileUrl — data-URL с base64 (MVP);
/// R2 — следующий шаг (см. отчёт этапа 4).
model Document {
  id           String       @id @default(cuid())
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId       String
  type         DocumentType
  /// «СЧ-001», «Д-001», «ТН-001», «УПД-001» — инкремент по типу.
  number       String       @unique
  /// base64 PDF (data-URL) — до подключения R2.
  fileUrl      String
  generatedAt  DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@index([dealId])
  @@index([type])
}

/// Рекламация покупателя (этап 4). Поставщик виден внутри приложения,
/// в документах покупателю не упоминается (white-label).
model Claim {
  id                 String       @id @default(cuid())
  deal               Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId             String
  description        String
  /// Фото — когда подключим R2 (этап медиа).
  photos             String[]
  status             ClaimStatus  @default(NEW)
  resolution         String?
  forwardedToSupplier Boolean     @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([dealId])
  @@index([status])
}

/* ---------- Этап 5.1: серверные сессии владельца ---------- */

/// Сессия владельца приложения. В cookie лежит случайный токен;
/// в базе — только его SHA-256 (сам токен не хранится).
model OwnerSession {
  id         String   @id @default(cuid())
  /// SHA-256(token) hex — поиск сессии по хешу.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/* ---------- Этап 2.5: цены конкурентов (парсер) ---------- */

/// Обезличенные цены с досок объявлений и Telegram-каналов (152-ФЗ:
/// только цены/названия/ссылки, без телефонов, ФИО и адресов).
model CompetitorPrice {
  id         String      @id @default(cuid())
  source     PriceSource
  /// Поисковый запрос парсера («люцерна», «грецкий орех»), lowercase.
  query      String
  price      Decimal     @db.Decimal(10, 2)
  /// Единица: «₽/кг».
  unit       String
  region     String?
  /// Название компании-продавца или @username (обезличенно).
  sellerName String?
  /// Ссылка на объявление/сообщение.
  link       String
  /// Краткий фрагмент объявления (контакты вычищены).
  rawSnippet String
  /// Когда парсер собрал строку.
  fetchedAt  DateTime
  createdAt  DateTime    @default(now())

  @@index([source])
  @@index([query])
  @@index([fetchedAt])
  @@index([source, query, fetchedAt])
}
