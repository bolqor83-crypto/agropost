// АгроПост — схема Prisma.
// Этап 0: каркас. Этап 1: Supplier, CultureTemplate, SupplierPosition
// (attributes JsonB по шаблону культуры), Media, Certificate, User.
// Этап 2: Channel, Account, Listing. Этап 4: Deal, Shipment, Claim, Document.
// Этап 2.5 (парсер): CompetitorPrice, PriceAlert.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- Этап 1: поставщики, культуры, позиции, медиа ---------- */

enum SupplierLocation {
  PAVLOVSKAYA
  LENINGRADSKAYA
  TIHORETSK
  OTHER
}

enum ShippingMode {
  SELF_LOADS
  FROM_WAREHOUSE
  BOTH
}

enum CultureType {
  SEED
  NUT
}

enum PositionStatus {
  IN_STOCK
  ON_ORDER
  OUT_OF_STOCK
}

enum MediaType {
  PHOTO
  VIDEO
}

enum TaxMode {
  IP
  SELF_EMPLOYED
}

/* ---------- Этап 2: каналы, аккаунты, размещения ---------- */

enum ChannelType {
  TELEGRAM_CHAT
  TELEGRAM_CHANNEL
  AVITO
  AGROSERVER
  MAX
  YOULA
  OTHER
}

enum AccountPlatform {
  TELEGRAM
  AVITO
  MAX
  YOULA
  OTHER
}

enum AccountStatus {
  ACTIVE
  LIMITED
  PAUSED
  BLOCKED
}

enum ListingStatus {
  DRAFT
  COPIED
  PUBLISHED
}

model Supplier {
  id           String             @id @default(cuid())
  name         String
  phone        String
  location     SupplierLocation
  shippingMode ShippingMode
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  positions    SupplierPosition[]

  @@index([location])
}

model CultureTemplate {
  id               String             @id @default(cuid())
  name             String             @unique
  type             CultureType
  /// Массив {key, label, type, unit, required} — схема атрибутов позиций.
  attributesSchema Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  positions        SupplierPosition[]

  @@index([type])
}

model SupplierPosition {
  id             String           @id @default(cuid())
  supplier       Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId     String
  culture        CultureTemplate  @relation(fields: [cultureId], references: [id], onDelete: Restrict)
  cultureId      String
  /// Плоский JSONB {key: value} по схеме attributesSchema культуры.
  attributes     Json
  /// Остаток, кг. Обновляется вручную.
  volumeKg       Int
  bagWeightKg    Int
  /// Закуп поставщика, ₽/кг.
  supplierPrice  Decimal          @db.Decimal(10, 2)
  markupPercent  Decimal          @db.Decimal(5, 2)
  /// Вычисляется на сервере: supplierPrice × (1 + markupPercent / 100).
  salePrice      Decimal          @db.Decimal(10, 2)
  minLotKg       Int
  hasCertificate Boolean          @default(false)
  status         PositionStatus   @default(IN_STOCK)
  media          Media[]
  certificates   Certificate[]
  listings       Listing[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([supplierId])
  @@index([cultureId])
  @@index([status])
  @@index([updatedAt])
}

model Media {
  id         String           @id @default(cuid())
  position   SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String
  type       MediaType
  /// Публичный URL в R2 (в демо-сиде — data-URL заглушки).
  url        String
  watermark  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([positionId])
}

model Certificate {
  id         String           @id @default(cuid())
  position   SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String
  name       String
  fileUrl    String
  issuedAt   DateTime?
  createdAt  DateTime         @default(now())

  @@index([positionId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  taxMode   TaxMode
  /// Доля налога, например 0.06 (УСН доходы) или 0.07 (НПД).
  taxRate   Decimal  @db.Decimal(5, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* Этап 2. Теги каналов — String[] со словарём в коде (shared/channels.ts,
   zod-валидация): новый тег без миграции. Сессии аккаунтов — этап 3. */

model Account {
  id         String          @id @default(cuid())
  platform   AccountPlatform
  phone      String?
  status     AccountStatus   @default(ACTIVE)
  /// Лимит размещений в день (учёт; автоматический постинг — этап 3).
  dailyLimit Int             @default(20)
  /// Использовано за день usedDate (сбрасывается при смене дня).
  usedToday  Int             @default(0)
  usedDate   DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  channels   Channel[]

  @@index([platform])
  @@index([status])
}

model Channel {
  id               String      @id @default(cuid())
  name             String
  type             ChannelType
  /// Deep link: t.me/username, t.me/c/XXX, URL подачи/чата.
  url              String
  region           String
  tags             String[]
  subscribersCount Int?
  averageReach     Int?
  lastActivityAt   DateTime?
  /// Аккаунт, которым размещаем (SetNull при удалении аккаунта).
  accountId        String?
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  listings         Listing[]

  @@index([type])
  @@index([region])
}

model Listing {
  id          String           @id @default(cuid())
  position    SupplierPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId  String
  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String
  /// Черновик текста (white-label: поставщик не упоминается).
  text        String
  status      ListingStatus    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([positionId])
  @@index([channelId])
  @@index([status])
}
