{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src", "prisma", "prisma.config.ts", "../../shared"],
  "exclude": ["src/ai/__tests__"]
}
