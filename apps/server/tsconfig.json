{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src", "prisma", "prisma.config.ts", "../../shared", "src/documents/packages.d.ts"],
  "exclude": ["src/max/__tests__", "src/routes/__tests__", "src/ai/__tests__", "src/telegram/__tests__", "src/deals/__tests__", "src/documents/__tests__", "src/analytics/__tests__", "src/auth/__tests__", "src/storage/__tests__", "src/media/__tests__", "src/feeds/__tests__", "src/publishers/avito/__tests__"]
}
