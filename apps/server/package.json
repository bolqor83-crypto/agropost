{
  "name": "@agropost/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "test": "bun test src/ai src/telegram src/deals src/documents src/analytics src/auth",
    "test:golden": "bun test src/ai/__tests__/golden.integration.test.ts",
    "test:deals": "bun test src/deals src/documents",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@fastify/cors": "^10.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "grammy": "^1.48.0",
    "pdfmake": "^0.3.15",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.2.1",
    "typescript": "~5.7.2"
  }
}
